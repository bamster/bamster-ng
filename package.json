{
  "name": "bamster",
  "version": "1.0.0",
  "private": true,
  "description": "BAMster - A Tetris-meets-platformer game with a hamster and laser pistol",
  "scripts": {
    "dev": "pnpm --filter @bamster/client dev",
    "dev:server": "pnpm --filter @bamster/server dev",
    "dev:all": "pnpm run --parallel /dev/",
    "build": "pnpm -r build",
    "build:prod": "pnpm -r build && echo 'Production builds complete'",
    "start:server": "pnpm --filter @bamster/server start:prod",
    "preview": "pnpm --filter @bamster/client preview",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r exec rm -rf dist"
  },
  "keywords": [
    "game",
    "phaser",
    "tetris",
    "platformer"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "vitest": "^4.0.18"
  }
}
